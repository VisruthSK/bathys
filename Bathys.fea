feature liga {
sub C O R by C_O_R;
sub C.sc O.sc R.sc by C_O_R.sc;
sub C O by C_O;
sub C.sc O.sc by C_O.sc;
sub O R by O_R;
sub O.sc R.sc by O_R.sc;
sub B A by B_A;
sub B.sc A.sc by B_A.sc;
sub R A by R_A;
sub R.sc A.sc by R_A.sc;
} liga;
feature dlig {
sub O O by O_O;
sub O.sc O.sc by O_O.sc;
sub O C by O_C;
sub O.sc C.sc by O_C.sc;
sub R O by R_O;
sub R.sc O.sc by R_O.sc;
sub L A by L_A;
sub L.sc A.sc by L_A.sc;
} dlig;
